---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Private cinema for Lightalso',
  title: 'Cinema'
}
---

<PageLayout {meta}>
  <Button title="Back" href="/blog" variant="back" />
  <main class="mt-6 lg:mt-10">
    <div id="content-header" class="animate">
      <h1 class="mb-6 text-3xl font-medium">放映厅</h1>
    </div>

    <div id="content" class="animate">
      <link
        href="https://web.sdk.qcloud.com/player/tcplayer/release/v5.1.0/tcplayer.min.css"
        rel="stylesheet"
      />

      <div class="video-container">
        <video
          id="tencentlive-player"
          preload="auto"
          playsinline
          webkit-playsinline
          muted
        ></video>
      </div>
    </div>
  </main>

  <!-- 外部脚本必须 is:inline -->
  <script src="https://web.sdk.qcloud.com/player/tcplayer/release/v5.1.0/tcplayer.v5.1.0.min.js" is:inline></script>
  <script is:inline>
    if (typeof window !== 'undefined' && typeof TCPlayer !== 'undefined') {
      TCPlayer('tencentlive-player', {
        autoplay: true,
        sources: [{
          src: 'https://livestream.lightalso.com/lightalso/lightalso.m3u8?txSecret=7d4d0e03400efc93bc493b7442fe423d&txTime=6B367BFF',
        }],
        licenseUrl: 'https://license.vod2.myqcloud.com/license/v2/1314950865_1/v_cube.license',
      });
    }
  </script>

  <style is:global>
    .video-container {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 10px;
      overflow: hidden;
    }

    #tencentlive-player,
    #tencentlive-player video,
    #tencentlive-player .tcplayer,
    #tencentlive-player .vjs-tech,
    .video-container > div {
      width: 100% !important;
      height: 100% !important;
    }

    #tencentlive-player {
      display: block;
      border: none;
    }
    
    #tencentlive-player video,
    #tencentlive-player .vjs-tech {
      object-fit: contain;
    }
  </style>
</PageLayout>
