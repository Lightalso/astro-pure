          href='https://www.pku.edu.cn/'
        >
          <div class='flex flex-col gap-2 leading-6 text-muted-foreground'>
            <p>全日制 - 机械专业硕士</p> 
          </div>
          <img
            class='absolute end-0 z-0 m-0 -my-3 h-full w-1/2 object-cover opacity-20'
            src='/images/PKU.svg'
