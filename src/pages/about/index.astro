---
import config from 'virtual:config'

import { Button, Collapse, Signature, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import zotero from '@/assets/tools/zotero.png'

const headings = [
  {
    depth: 2,
    slug: 'tools',
    text: 'Tools'
  },
  {
    depth: 2,
    slug: 'social-networks',
    text: 'Social Networks'
  },
  {
    depth: 2,
    slug: 'education',
    text: 'Education'
  },
  // {
  //   depth: 2,
  //   slug: 'experience',
  //   text: 'Experience'
  // },
  {
    depth: 2,
    slug: 'about-blog',
    text: 'About Blog'
  }
]
---

<PageLayout title='About' {headings} comment>
  <h2 id='general-talk' class='invisible m-0 h-0'>General Talk</h2>
  <p class='text-muted-foreground mt-1'>Developer / Student / Gamer</p>
  <p>你好，我叫 Lightalso，一个平平无奇的普通大学生。</p>
  <p>目前就读于南昌大学软件学院，即将在北京大学力学与工程科学学院攻读硕士学位。</p>
  <p>我的兴趣主要在 LLM / AI4S 方向。</p>
  <p>我喜欢怪物猎人和守望先锋。</p>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>以下是我正在使用的一些工具：</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Microsoft Edge',
        description: 'Browser',
        href: 'https://www.microsoft.com/edge',
        icon: import('@/assets/tools/edge.svg?raw')
      },
      {
        name: 'Tailscale',
        description: 'VPN',
        href: 'https://tailscale.com/',
        icon: import('@/assets/tools/tailscale.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      },
      {
        name: 'Zotero',
        description: 'Reference Management',
        href: 'https://www.zotero.org/',
        icon: zotero
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'Cursor',
        description: 'AI Code Editor',
        href: 'https://www.cursor.com/',
        icon: import('@/assets/tools/cursor.svg?raw'),
        darkIcon: import('@/assets/tools/cursor_dark.svg?raw')
      },
      {
        name: 'JetBrains',
        description: 'IDE',
        href: 'https://www.jetbrains.com/',
        icon: import('@/assets/tools/jetbrains.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Design'
    tools={[
      {
        name: 'Photoshop',
        description: 'Picture Editing',
        href: 'https://www.adobe.com/products/photoshop',
        icon: import('@/assets/tools/photoshop.svg?raw')
      },
      {
        name: 'Illustrator',
        description: 'Vector Drawing',
        href: 'https://www.adobe.com/products/illustrator',
        icon: import('@/assets/tools/illustrator.svg?raw')
      },
      {
        name: 'Premiere Pro',
        description: 'Video Editing',
        href: 'https://www.adobe.com/products/premiere',
        icon: import('@/assets/tools/premierepro.svg?raw')
      },
      {
        name: 'Audition',
        description: 'Audio Editing',
        href: 'https://www.adobe.com/products/audition',
        icon: import('@/assets/tools/audition.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Windows 11',
        description: "ASUS TUF GAMING",
        href: 'https://www.microsoft.com/windows',
        icon: import('@/assets/tools/windows11.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>你可以在以下平台找到我：</p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/Lightalso',
        text: 'followers',
        api: 'github/Lightalso'
      },
      {
        platform: '网易云',
        icon: 'netease',
        color: '#ff0000',
        link: 'https://music.163.com/#/user/home?id=441080434',
        text: 'followers',
        api: 'neteasemusic/441080434'
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#fe7398',
        link: 'https://space.bilibili.com/364380644',
        text: 'followers',
        count: 23
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/id/lightalso',
        text: 'games',
        count: 137
      },
    ]}
  />

  <h2 id='education'>Education</h2>
  <Timeline
    events={[
      {
        date: '2026-09-01',
        content: '<a href="https://www.pku.edu.cn"target="_blank">北京大学力学与工程科学学院</a>'
      },
      {
        date: '2022-09-01',
        content: '<a href="https://www.ncu.edu.cn/"target="_blank">南昌大学软件学院</a>'
      }
    ]}
  />

  <!-- <h2 id='experience'>Experience</h2>
  <Timeline
    events={[
      {
        date: '2024-09-11',
        content:
          '<a href="https://slide.huh.moe/"target="_blank">北京大学 · 《计算机系统导论》课程助教</a>'
      }
    ]}
  /> -->

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>本站基于以下项目/服务提供商的资源和技术支持：</p>
  <ul>
    <li>域名 & 托管: <a href='https://cloud.tencent.com/' target='_blank'>Tencent Cloud</a></li>
    <li>
      框架 & 主题: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>评论系统：<a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>
      访问量统计：<a href='https://umami.is/' target='_blank'>Umami</a>
    </li>
    <li>
      粉丝数统计：<a href='https://github.com/spencerwooo/substats' target='_blank'>Substats</a>
    </li>
  </ul>
  {config.signature && <Signature />}
</PageLayout>
